# Copie para .env. Tudo é opcional no 0.1.

# Chave PRÓPRIA do THORN (não usa o login do Claude Code). Sem ela, o loop de IA
# fica desligado; memória e policy continuam funcionando.
# ANTHROPIC_API_KEY=sk-ant-...

# Modelo do gateway (default claude-opus-5).
# THORN_MODEL=claude-opus-5

# Onde a memória mora (default ~/.thorn/thorn.db).
# THORN_HOME=~/.thorn

# Embedder: "hashing" (default, offline, zero deps) — troque por um modelo local
# ou Voyage quando quiser embeddings de verdade.
# THORN_EMBEDDER=hashing
